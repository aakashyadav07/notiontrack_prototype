generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  FACULTY
  STUDENT
}

enum ExamType {
  REGULAR
  SUPPLEMENTARY
  PRACTICAL
}

enum ExamStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  COMPLETED
  CANCELLED
}

enum SessionType {
  MORNING
  AFTERNOON
  EVENING
}

enum SessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RegStatus {
  REGISTERED
  WITHDRAWN
  DEBARRED
}

enum TimetableStatus {
  DRAFT
  GENERATING
  GENERATED
  PUBLISHED
  ARCHIVED
}

enum InvigilatorRole {
  CHIEF
  INVIGILATOR
  RELIEVER
}

enum ConstraintType {
  NO_STUDENT_CONFLICT
  NO_ROOM_CONFLICT
  ROOM_CAPACITY
  NO_FACULTY_CONFLICT
  MIN_GAP_BETWEEN_EXAMS
  MAX_EXAMS_PER_DAY
  PREFERRED_TIME_SLOTS
  AVOID_CONSECUTIVE_DAYS
  BALANCE_ROOM_UTILIZATION
  BALANCE_INVIGILATOR_WORKLOAD
  ANTI_CHEATING_SEATING
}

enum ConflictType {
  STUDENT_TIME_CONFLICT
  ROOM_DOUBLE_BOOKING
  FACULTY_DOUBLE_BOOKING
  ROOM_CAPACITY_EXCEEDED
  MISSING_ROOM
  MISSING_INVIGILATOR
  INVALID_TIME_SLOT
  DUPLICATE_ALLOCATION
  INVALID_REGISTRATION
  EXAM_OUTSIDE_PERIOD
}

enum ConflictSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NotificationType {
  TIMETABLE_PUBLISHED
  EXAM_SCHEDULE_CHANGED
  ROOM_CHANGED
  SEAT_ALLOCATION_PUBLISHED
  CONFLICT_DETECTED
  ADMIN_ALERT
  SYSTEM
}

enum JobType {
  TIMETABLE_GENERATION
  SEAT_ALLOCATION
  INVIGILATOR_ASSIGNMENT
  CONFLICT_DETECTION
  REPORT_GENERATION
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  role          Role      @default(STUDENT)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  student       Student?
  faculty       Faculty?
  notifications Notification[]
  auditLogs     AuditLog[]

  @@map("users")
}

model Department {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  students    Student[]
  faculty     Faculty[]
  subjects    Subject[]
  rooms       Room[]

  @@map("departments")
}

model Student {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentId         String    @unique
  departmentId      String
  department        Department @relation(fields: [departmentId], references: [id])
  semester          Int
  section           String?
  enrollments       Enrollment[]
  examRegistrations ExamRegistration[]
  seatAllocations   SeatAllocation[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([departmentId, semester, section])
  @@map("students")
}

model Faculty {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId              String    @unique
  departmentId            String
  department              Department @relation(fields: [departmentId], references: [id])
  designation             String
  maxWorkload             Int       @default(4)
  invigilatorAssignments  InvigilatorAssignment[]
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@map("faculty")
}

model Subject {
  id            String    @id @default(cuid())
  code          String    @unique
  name          String
  departmentId  String
  department    Department @relation(fields: [departmentId], references: [id])
  credits       Int       @default(3)
  examDuration  Int       @default(180)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  exams         Exam[]
  enrollments   Enrollment[]

  @@map("subjects")
}

model Enrollment {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId  String
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([studentId, subjectId])
  @@map("enrollments")
}

model Room {
  id                String   @id @default(cuid())
  code              String   @unique
  name              String
  capacity          Int
  departmentId      String?
  department        Department? @relation(fields: [departmentId], references: [id])
  floor             Int?
  building          String?
  hasProjector      Boolean  @default(false)
  hasAC             Boolean  @default(false)
  isAccessible      Boolean  @default(false)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  examSessions      ExamSession[]
  seatLayout        SeatLayout?
  timetableEntries  TimetableEntry[]
  seatAllocations   SeatAllocation[]
  invigilatorAssignments InvigilatorAssignment[]

  @@map("rooms")
}

model SeatLayout {
  id        String   @id @default(cuid())
  roomId    String   @unique
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  rows      Int
  columns   Int
  layout    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("seat_layouts")
}

model Exam {
  id                      String       @id @default(cuid())
  subjectId               String
  subject                 Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  examType                ExamType     @default(REGULAR)
  duration                Int
  maxStudents             Int?
  status                  ExamStatus   @default(DRAFT)
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  examSessions            ExamSession[]
  registrations           ExamRegistration[]
  timetableEntries        TimetableEntry[]
  invigilatorAssignments  InvigilatorAssignment[]
  seatAllocations         SeatAllocation[]

  @@index([subjectId, examType])
  @@map("exams")
}

model ExamSession {
  id          String       @id @default(cuid())
  examId      String
  exam        Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  roomId      String?
  room        Room?        @relation(fields: [roomId], references: [id], onDelete: SetNull)
  date        DateTime
  startTime   DateTime
  endTime     DateTime
  sessionType SessionType  @default(MORNING)
  status      SessionStatus @default(SCHEDULED)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([date, startTime])
  @@index([roomId, date, startTime])
  @@map("exam_sessions")
}

model ExamRegistration {
  id              String     @id @default(cuid())
  studentId       String
  student         Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examId          String
  exam            Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  registeredAt    DateTime   @default(now())
  status          RegStatus  @default(REGISTERED)

  @@unique([studentId, examId])
  @@index([examId])
  @@map("exam_registrations")
}

model Timetable {
  id            String            @id @default(cuid())
  name          String
  description   String?
  startDate     DateTime
  endDate       DateTime
  status        TimetableStatus   @default(DRAFT)
  generatedBy   String
  generatedAt   DateTime?
  publishedAt   DateTime?
  publishedBy   String?
  metadata      Json?
  entries       TimetableEntry[]
  conflicts     Conflict[]
  seatAllocations SeatAllocation[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@map("timetables")
}

model TimetableEntry {
  id            String      @id @default(cuid())
  timetableId   String
  timetable     Timetable   @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  examId        String
  exam          Exam        @relation(fields: [examId], references: [id], onDelete: Cascade)
  roomId        String
  room          Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  date          DateTime
  startTime     DateTime
  endTime       DateTime
  sessionType   SessionType
  createdAt     DateTime    @default(now())

  @@index([timetableId, date, startTime])
  @@index([roomId, date, startTime])
  @@map("timetable_entries")
}

model SeatAllocation {
  id            String      @id @default(cuid())
  timetableId   String
  timetable     Timetable   @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examId        String
  exam          Exam        @relation(fields: [examId], references: [id], onDelete: Cascade)
  roomId        String
  room          Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  seatRow       String
  seatColumn    Int
  seatNumber    String
  createdAt     DateTime    @default(now())

  @@unique([timetableId, studentId, examId])
  @@index([timetableId, roomId])
  @@index([studentId])
  @@map("seat_allocations")
}

model InvigilatorAssignment {
  id            String            @id @default(cuid())
  examId        String
  exam          Exam              @relation(fields: [examId], references: [id], onDelete: Cascade)
  facultyId     String
  faculty       Faculty           @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  roomId        String?
  room          Room?             @relation(fields: [roomId], references: [id], onDelete: SetNull)
  date          DateTime
  startTime     DateTime
  endTime       DateTime
  role          InvigilatorRole   @default(INVIGILATOR)
  createdAt     DateTime          @default(now())

  @@index([facultyId, date, startTime])
  @@index([examId])
  @@map("invigilator_assignments")
}

model Constraint {
  id          String        @id @default(cuid())
  name        String
  type        ConstraintType
  description String?
  config      Json
  isActive    Boolean       @default(true)
  priority    Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("constraints")
}

model Conflict {
  id                    String            @id @default(cuid())
  timetableId           String?
  timetable             Timetable?        @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  type                  ConflictType
  severity              ConflictSeverity
  description           String
  entityType            String
  entityId              String
  relatedEntityType     String?
  relatedEntityId       String?
  metadata              Json?
  isResolved            Boolean           @default(false)
  resolvedAt            DateTime?
  resolvedBy            String?
  createdAt             DateTime          @default(now())

  @@index([timetableId, isResolved])
  @@index([type, severity])
  @@map("conflicts")
}

model Notification {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType
  metadata  Json?
  isRead    Boolean           @default(false)
  readAt    DateTime?
  createdAt DateTime          @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  entityType String
  entityId  String
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model BackgroundJob {
  id            String    @id @default(cuid())
  type          JobType
  status        JobStatus @default(PENDING)
  payload       Json
  result        Json?
  progress      Int       @default(0)
  error         String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([type, status])
  @@map("background_jobs")
}